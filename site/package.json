{
	"name": "site",
	"private": true,
	"version": "0.13.0",
	"type": "module",
	"scripts": {
		"sync:content": "node scripts/copy-content.mjs",
		"predev": "node scripts/copy-content.mjs",
		"dev": "vite dev",
		"prebuild": "node scripts/copy-content.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:viewer": "vitest run src/lib/viewer"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22.20.2",
		"jsdom": "^30.0.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^7.0.2",
		"unocss": "^66.10.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	},
	"comment:overrides": "Transitive deps held below a patched release by a parent that has not re-published. Each stays within its parent's accepted major, so this only advances the patch level. Drop an entry once the parent's own range reaches it: dompurify<-@rokkit/ui (the only one that ships to the browser); undici/ws/esbuild/cookie/sharp<-vite and wrangler>miniflare, which are build-time only.",
	"overrides": {
		"dompurify": "^3.4.15",
		"undici": "^7.29.0",
		"ws": "^8.21.3",
		"esbuild": "^0.28.2",
		"cookie": "^0.7.2",
		"sharp": "^0.35.4"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/space-grotesk": "^5.3.0",
		"@rokkit/actions": "^1.4.1",
		"@rokkit/app": "^1.4.1",
		"@rokkit/core": "^1.4.1",
		"@rokkit/icons": "^1.4.1",
		"@rokkit/states": "^1.4.1",
		"@rokkit/themes": "^1.4.1",
		"@rokkit/ui": "^1.4.1",
		"@rokkit/unocss": "^1.4.1",
		"fflate": "^0.8.3",
		"marked": "^18.0.12"
	}
}
