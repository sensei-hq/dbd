      "schema": "config",
      "name": "lookup_values",
      "kind": "table",
      "note": "Different values associated with various lookups.",
      "noteMd": "Different values associated with various lookups.\n- Used to store predefined values for different lookup categories.\n- Each value is associated with a specific lookup.",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "pk": true,
          "nn": true,
          "def": "uuid_generate_v4()",
          "note": "Unique identifier for the lookup value. Ensures each value can be uniquely identified."
        },
        {
          "name": "lookup_id",
          "type": "uuid",
          "fk": true,
          "note": "Identifier for the lookup category. References the lookups table to specify the category."
        },
        {
          "name": "value",
          "type": "varchar(255)",
          "note": "The actual value associated with the lookup."
        },
        {
          "name": "sequence",
          "type": "int",
          "note": "Order of the value within the lookup category. Used for sorting purposes."
        },
        {
          "name": "is_active",
          "type": "boolean",
          "def": "true",
          "note": "Flag indicating if the lookup value is active. Used to determine if the value is currently in use."
        },
        {
          "name": "is_hidden",
          "type": "boolean",
          "def": "false",
          "note": "Flag indicating if the lookup value should be hidden. Used to exclude the value from display."
        },
        {
          "name": "details",
          "type": "jsonb",
          "note": "Additional details associated with the lookup value. Stored as a JSONB field to accommodate various attributes."
        },
        {
          "name": "description",
          "type": "text",
          "note": "Description of the lookup value. Provides additional context about the value."
        },
        {
          "name": "modified_at",
          "type": "timestamp with time zone",
          "nn": true,
          "def": "now()",
          "note": "The date the lookup value was last modified. Provides a history of when changes were made."
        },
        {
          "name": "modified_by",
          "type": "varchar",
          "note": "The user who last modified the lookup value. Tracks who made the changes for auditing purposes."
        },
        {
          "name": "category_id",
          "type": "uuid",
          "fk": true
        },
        {
          "name": "notes",
          "type": "text"
        }
      ],
